# Development Dockerfile - runs with Deno runtime instead of compiling
FROM denoland/deno:debian-2.1.9

# Set the working directory
WORKDIR /app

# Copy application files
COPY . .

# Cache dependencies with node_modules
RUN deno cache --reload --node-modules-dir example-simple.ts

# Expose the port
EXPOSE 4123

# Run simple example (no Redis/MQTT required)
CMD ["deno", "run", "--no-check", "-A", "--node-modules-dir", "example-simple.ts"]